{
  "name": "dsh-cursor",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Windows-only: import the local Cursor account model catalog into the Harness model picker, and emit Claude Code / Codex model configuration.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.md",
    "scripts/*.mjs"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "os": [
    "win32"
  ]
}
